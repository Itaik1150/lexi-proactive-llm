# Copy to .env and fill in. NEVER commit the real file (.env is git-ignored).

PORT=5000
NODE_ENV=development            # production on Render

# Full Atlas connection string. Credentials live here; there are no separate user/password variables.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=<database-name>

# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=

# Origin of the React app (used for links on the /join landing page and CORS).
FRONTEND_URL=http://localhost:3000

# Where /join/<experimentId>/download redirects. Point this at your signed release APK.
APK_DOWNLOAD_URL=
