# Copy to .env and fill in. NEVER commit the real file (.env is git-ignored).

# --- MongoDB Atlas (shared with the Node API) ---------------------------------
# Use a dedicated database user with read/write on this one database only.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=<database-name>
MONGODB_USERS_COLLECTION=users

# --- LLM ----------------------------------------------------------------------
# Default provider/model; each experiment can override the model from the dashboard.
LLM_PROVIDER=openai            # openai | anthropic
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=             # only needed if any experiment uses a claude-* model

# --- Firebase Cloud Messaging -------------------------------------------------
# Locally: path to the service-account JSON file (keep it OUTSIDE the repo).
# On Render: paste the whole JSON into SERVICE_ACCOUNT_JSON_CONTENT (or use a Secret File).
SERVICE_ACCOUNT_JSON=
SERVICE_ACCOUNT_JSON_CONTENT=
FCM_DEFAULT_TITLE=Lexi

# --- Where to send the "create conversation" call -----------------------------
# Defaults point at PRODUCTION. For local testing set these to your local server,
# otherwise a test run creates real conversations on the live API.
LEXI_SERVER_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:3000
