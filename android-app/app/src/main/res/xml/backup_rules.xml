<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up: the app's data includes the login session and the push token.
  (allowBackup is also false in the manifest; this covers devices before Android 12.)
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
